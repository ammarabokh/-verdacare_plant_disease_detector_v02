# Hugging Face API Token
# Get yours from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# Kaggle API Credentials
# Get yours from: https://www.kaggle.com/settings/account
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key
KAGGLE_NOTEBOOK=your_username/your_notebook_slug
KAGGLE_MODEL_FILENAME=plant_disease_classifier_efficientnetb0.keras

# Flask Secret Key (generate a random string)
SECRET_KEY=your-secret-key-here

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=True

# Mock mode if model fails to load
USE_MOCK_IF_MODEL_FAIL=false

# One-time admin bootstrap (recommended for first deployment only)
# After first successful run, set ADMIN_BOOTSTRAP_ENABLED=false and rotate password.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-this-strong-password
ADMIN_BOOTSTRAP_FULL_NAME=System Administrator
