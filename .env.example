# Hugging Face API Token
# Get yours from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# Kaggle API Credentials
# Get yours from: https://www.kaggle.com/settings/account
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key
KAGGLE_NOTEBOOK=your_username/your_notebook_slug
KAGGLE_MODEL_FILENAME=plant_disease_classifier_efficientnetb0.keras

# Flask Secret Key (generate a random string)
SECRET_KEY=your-secret-key-here

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=True

# Mock mode if model fails to load
USE_MOCK_IF_MODEL_FAIL=false
